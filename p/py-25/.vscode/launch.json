{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: relativeFile",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "${relativeFile}",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger"
            ],
            "jinja": true,
            "autoStartBrowser": false
        },
    ]
}